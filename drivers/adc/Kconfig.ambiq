config ADC_AMBIQ
	bool "Ambiq Adc Driver"
	default y
	depends on DT_HAS_AMBIQ_ADC_ENABLED
	select AMBIQ_HAL
	select AMBIQ_HAL_USE_ADC
	select AMBIQ_HAL_USE_TIMER if SOC_SERIES_APOLLO3X
	help
	  Enables the Adc driver for Ambiq devices.

if ADC_AMBIQ

config ADC_AMBIQ_HANDLE_CACHE
	bool "Turn on cache handling in adc driver"
	default y
	depends on CACHE_MANAGEMENT && DCACHE
	help
	  Disable this if cache has been handled in upper layers.

config ADC_AMBIQ_DMA
	bool "Ambiq ADC DMA Support."
	default n
	help
	  Enable the ADC DMA mode for ADC instances
	  that enable dma channels in their device tree node.

if ADC_AMBIQ_DMA

config ADC_AMBIQ_DMA_MIN_SAMPLES
	int "Minimum number of samples to use DMA mode"
	default 64
	range 1 65535
	help
	  When DMA mode is enabled in device tree, the driver will only use DMA
	  if the total number of samples (channels × (1 + extra_samplings)) is
	  greater than or equal to this value. Otherwise, interrupt mode will be
	  used. This allows both DMA and interrupt modes to coexist based on
	  the workload size.

config ADC_AMBIQ_STREAM
	bool "Ambiq ADC RTIO streaming support"
	select ADC_STREAM
	select RTIO
	select RTIO_WORKQ
	select RTIO_SYS_MEM_BLOCKS
	help
	  Enable native RTIO submit and streaming support for the Ambiq ADC.

	  Streaming uses the ADC DMA engine together with the internal repeat
	  trigger timer to continuously sample the configured channels into RTIO
	  memory-pool buffers, which are then decoded through the ADC decoder
	  API. One-shot RTIO reads are serviced on the RTIO work queue.

	  This depends on ADC_AMBIQ_DMA. When disabled, RTIO reads still work
	  through the generic work-queue fallback (CONFIG_ADC_DEFAULT_RTIO), but
	  continuous streaming is not available.

endif # ADC_AMBIQ_DMA

endif # ADC_AMBIQ
