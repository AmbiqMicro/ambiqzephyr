config CRYPTO_AMBIQ_AES
	bool "Ambiq CryptoCell AES driver"
	default y
	depends on DT_HAS_AMBIQ_CRYPTO_AES_ENABLED
	select AMBIQ_HAL
	select POWER_DOMAIN
	select AMBIQ_CC312_ARBITER
	help
		Enable the Ambiq CryptoCell-312 AES cipher driver.

		Supported cipher modes:
		- ECB
		- CBC
		- CTR
		- OFB
		- CCM
		- GCM
		- XTS

config CRYPTO_AMBIQ_CHACHA
	bool "Ambiq CryptoCell ChaCha20 driver"
	default y
	depends on DT_HAS_AMBIQ_CRYPTO_CHACHA_ENABLED
	select AMBIQ_HAL
	select POWER_DOMAIN
	select AMBIQ_CC312_ARBITER
	help
		Enable the Ambiq CryptoCell-312 ChaCha20 stream cipher driver.

		Supported cipher modes:
		- ChaCha20 (stream cipher, encrypt/decrypt)

config CRYPTO_AMBIQ_SHA
	bool "Ambiq CryptoCell SHA driver"
	default y
	depends on DT_HAS_AMBIQ_CRYPTO_SHA_ENABLED
	select AMBIQ_HAL
	select POWER_DOMAIN
	select AMBIQ_CC312_ARBITER
	help
		Enable the Ambiq CryptoCell-312 SHA hash driver.

		Supported hash algorithms:
		- SHA-1
		- SHA-224
		- SHA-256

if CRYPTO_AMBIQ_SHA

config CRYPTO_AMBIQ_SHA_MAX_SESSION
	int "Maximum number of simultaneous SHA sessions"
	default 2
	range 1 8
	help
		Number of hash sessions that can be open at once. Each session
		holds its own running digest state, so sessions may be
		interleaved; access to the engine itself is serialised.

endif # CRYPTO_AMBIQ_SHA

config CRYPTO_AMBIQ_HMAC
	bool "Ambiq CryptoCell HMAC driver"
	default y
	depends on DT_HAS_AMBIQ_CRYPTO_HMAC_ENABLED
	select AMBIQ_HAL
	select POWER_DOMAIN
	select AMBIQ_CC312_ARBITER
	help
	  Enable the Ambiq CryptoCell-312 HMAC driver (SHA-1/224/256).

if CRYPTO_AMBIQ_HMAC

config CRYPTO_AMBIQ_HMAC_MAX_SESSION
	int "Maximum number of simultaneous HMAC sessions"
	default 2
	range 1 8

endif # CRYPTO_AMBIQ_HMAC

config CRYPTO_AMBIQ_CMAC
	bool "Ambiq CryptoCell AES-CMAC driver"
	default y
	depends on DT_HAS_AMBIQ_CRYPTO_CMAC_ENABLED
	select AMBIQ_HAL
	select POWER_DOMAIN
	select AMBIQ_CC312_ARBITER
	help
	  Enable the Ambiq CryptoCell-312 AES-CMAC driver.

	  Standalone AES-CBC-MAC is not exposed as a separate Zephyr driver;
	  use AES-CMAC or AES-CCM for message authentication on CC312.

if CRYPTO_AMBIQ_CMAC

config CRYPTO_AMBIQ_CMAC_MAX_SESSION
	int "Maximum number of simultaneous AES-CMAC sessions"
	default 2
	range 1 8

endif # CRYPTO_AMBIQ_CMAC

