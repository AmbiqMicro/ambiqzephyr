/*
 * All CC312 engines share IRQ 24. The SHA HAL polls for DMA completion, so a
 * sibling driver that connects an ISR would consume and clear the status the
 * poll is waiting on.
 */
&cc312_chacha {
	status = "disabled";
};

&cc312_sha {
	status = "okay";
};
