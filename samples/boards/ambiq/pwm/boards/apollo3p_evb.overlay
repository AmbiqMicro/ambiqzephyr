 * SPDX-License-Identifier: Apache-2.0
 *
 * This overlay configures 3 PWM outputs matching the Ambiq SDK
 * ctimer_pwm_output.c example:
 *
 *   PWM A: Timer 0, Segment B, GPIO 13 (CTIM2) - 10% duty cycle
 *   PWM B: Timer 2, Segment A, GPIO 29 (CTIM9) - 50% duty cycle
 *   PWM C: Timer 7, Segment B, GPIO 11 (CTIM31) - 70% duty cycle
 *
 * The 327 cycle period in the sample assumes the 32.768 kHz crystal,
 * so all three timers are moved off their default HFRC clocks here.
 * The GPIO 29 route is applied only in this sample: the board keeps
 * pwm2 on GPIO 30, where the onboard LED is.
 */

&pinctrl {
	pwm2_sample_default: pwm2_sample_default {
		group1 {
			pinmux = <CTIM9_P29>;
		};
	};
};

&timer0 {
	clk-source = "CLK_SELECT_XT_32_768KHZ";
};

&timer2 {
	clk-source = "CLK_SELECT_XT_32_768KHZ";
};

&timer7 {
	clk-source = "CLK_SELECT_XT_32_768KHZ";
};

/* Enable PWM0: Timer 0, Segment B, GPIO 13 */
&pwm0 {
	status = "okay";
};

/* Enable PWM2: Timer 2, Segment A, GPIO 29 */
&pwm2 {
	pinctrl-0 = <&pwm2_sample_default>;
	status = "okay";
};

/* Enable PWM7: Timer 7, Segment B, GPIO 11 */
&pwm7 {
	status = "okay";
};
