/*
 * PM power states for apollo330mP_evb.
 * Three suspend-to-idle states are defined, matching the CPU power-down
 * levels supported by the Apollo330P SoC.
 */

/ {
	zephyr,user {
		k_idle_state_min_residency_time = <300>;
	};
};

&cpu0 {
	cpu-power-states = <&stop0 &stop1 &stop2>;
};

&{/cpus/power-states} {
	stop0: stop0 {
		compatible = "zephyr,power-state";
		power-state-name = "suspend-to-idle";
		substate-id = <1>;
		min-residency-us = <300>;
		exit-latency-us = <50>;
	};

	stop1: stop1 {
		compatible = "zephyr,power-state";
		power-state-name = "suspend-to-idle";
		substate-id = <2>;
		min-residency-us = <700>;
		exit-latency-us = <300>;
	};

	stop2: stop2 {
		compatible = "zephyr,power-state";
		power-state-name = "suspend-to-idle";
		substate-id = <3>;
		min-residency-us = <1000>;
		exit-latency-us = <400>;
	};
};

/* Enable SPI0 on IOM0 (pinctrl already defined in apollo330mP_evb-pinctrl.dtsi) */
&spi0 {
	status = "okay";
};

/* Enable I2C1 on IOM1 (separate IOM from spi0, pinctrl already defined) */
&i2c1 {
	status = "okay";
};

/* Enable hardware CC312 AES accelerator */
&cc312_aes {
	status = "okay";
};
