&cpu0 {
	cpu-power-states = <&stop0 &stop1 &stop2>;
};

&{/cpus/power-states} {
	stop0: stop0 {
		compatible = "zephyr,power-state";
		power-state-name = "suspend-to-idle";
		substate-id = <1>;
		min-residency-us = <300>;
		exit-latency-us = <50>;
	};

	stop1: stop1 {
		compatible = "zephyr,power-state";
		power-state-name = "suspend-to-idle";
		substate-id = <2>;
		min-residency-us = <700>;
		exit-latency-us = <300>;
	};

	stop2: stop2 {
		compatible = "zephyr,power-state";
		power-state-name = "suspend-to-idle";
		substate-id = <3>;
		min-residency-us = <1000>;
		exit-latency-us = <400>;
	};
};

/* Enable hardware CC312 AES accelerator */
&cc312_aes {
	status = "okay";
};

/* Enable SPI0 on IOM0 */
&spi0 {
	status = "disabled";
};

/* Enable I2C0 on IOM0 — separate IOM from spi0 would need a different IOM;
 * apollo510dL_evb exposes i2c0 on IOM0 alongside spi0 (shared IOM, only one
 * can be active at a time).  Use i2c1 on IOM1 to keep them independent.
 */
&i2c1 {
	status = "disabled";
};

