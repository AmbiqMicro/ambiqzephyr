if BOARD_APOLLO510B_EVB

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 32768 if AMBIQ_STIMER_TIMER
	default 96000000 if CORTEX_M_SYSTICK

config LOG_BACKEND_SWO_FREQ_HZ
	default 1000000
	depends on LOG_BACKEND_SWO

if MSPI

config MSPI_INIT_PRIORITY
	default 40

endif # MSPI

if MEMC

config MEMC_INIT_PRIORITY
	default 50

endif # MEMC

if FLASH

config FLASH_INIT_PRIORITY
	default 50

endif # FLASH

config ROM_START_OFFSET
	default 0x400 if BOOTLOADER_MCUBOOT

if UDC_AMBIQ

# Apollo510 D-cache sits in front of USB DMA. Place UDC buffers in nocache SRAM
# so bulk/control transfers are coherent (CDC ACM and MSC fail otherwise).
config NOCACHE_MEMORY
	default y

endif # UDC_AMBIQ

endif # BOARD_APOLLO510B_EVB
