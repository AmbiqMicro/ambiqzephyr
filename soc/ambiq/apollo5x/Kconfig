config SOC_APOLLO510B
	select SOC_AMBIQ_BT_SUPPORTED

config SOC_APOLLO510B_EM9305_EXTREF_INIT
	bool "Wake SIP EM9305 for EXTREF clock"
	depends on SOC_APOLLO510B
	depends on DT_HAS_AMBIQ_BT_HCI_SPI_ENABLED
	depends on !MCUBOOT
	select GPIO
	select SPI
	select AMBIQ_COMPONENT_USE_BT
	select AMBIQ_HAL_USE_TIMER
	help
	  Wake the SIP EM9305 over SPI and enable sleep so CLKMGR can use EXTREF
	  (~12 MHz). Uses ambiq,bt-hci-spi in devicetree; CONFIG_BT is not
	  required.

config SOC_APOLLO510B_EM9305_EXTREF_INIT_PRIORITY
	int "Apollo510B EM9305 EXTREF clock init priority"
	default 51
	depends on SOC_APOLLO510B_EM9305_EXTREF_INIT

config SOC_APOLLO510L
	select SOC_AMBIQ_BT_SUPPORTED
	select SOC_AMBIQ_HAS_CRM
	select SOC_AMBIQ_HAS_RSS

config SOC_APOLLO330P
	select SOC_AMBIQ_BT_SUPPORTED
	select SOC_AMBIQ_HAS_CRM
	select SOC_AMBIQ_HAS_RSS

config SOC_AMBIQ_APOLLO5X_BLE_LP
	bool "AmbiqSuite ble_freertos_fit_lp style early SoC init"
	depends on SOC_APOLLO330P || SOC_APOLLO510L || SOC_APOLLO510B
	help
	  Align Zephyr early boot with boards/.../power/ble_freertos_fit_lp: LFRC for RTC,
	  XTAL power-down in deep sleep, DBGCTRL cleared, peripheral power gating, DTCM128K
	  + ROM auto, MRAM low-power bits, I/D cache off with CPDLP/cache power-down.
	  330P/510L: IOSFD0..NETAOL-1 gated (NETAOL/RSS kept), SRAM 0.75M retain.
	  510B (EM9305): ITCM32K/DTCM128K, NVM0 only, SSRAM 2M active/retain (LP overlay),
	  IOM6/CRYPTO/OTP kept for HCI SPI and TRNG.
	  Intended for BLE + tickless idle; not for throughput-focused builds.

if SOC_SERIES_APOLLO5X

config SOC_AMBIQ_RSS_MGR
	bool "Radio subsystem manager functions"
	default y
	depends on SOC_AMBIQ_HAS_RSS
	depends on DT_HAS_VND_MBOX_CONSUMER_ENABLED || DT_HAS_AMBIQ_MBOX_IPC_ENABLED || DT_HAS_AMBIQ_USB_ENABLED
	select NET_BUF
	select MBOX
	help
	  This option includes the radio subsystem manager functions for Apollo510L.

config SOC_AMBIQ_DEEPER_SLEEP_RECOVERY
	bool "Recovery window for the deeper sleep state"
	depends on PM && (SOC_APOLLO510L || SOC_APOLLO330P)
	select GPIO
	help
	  Apollo330P and Apollo510L map suspend-to-disk onto the Ambiq deeper
	  sleep state, which retains only NVM. A part that has entered it cannot
	  be halted, so a board that idles early in boot can only be reflashed by
	  racing its first idle, which is unreliable.

	  Sample a recovery pin during initialisation and, while it is asserted
	  through reset, block the state for a fixed window so a debugger can
	  attach and erase.

	  The pin is the pm-recovery alias if the board defines one, otherwise sw0.
	  Either may name any node carrying a gpios property, and the devicetree
	  flags decide whether asserted means low or high, so a board is free to
	  use a jumper or test point rather than a button. A board with neither
	  alias, such as apollo510L_eb, has no trigger and is unaffected.
	  Apollo510 does not offer the state at all.

	  Off by default. Recovering a board is a developer action, so nothing
	  samples a pin at boot unless a build asks for it. Enable it in the
	  configuration of a test or application that can strand a part.

config SOC_AMBIQ_DEEPER_SLEEP_BOOT_WINDOW_MS
	int "Recovery window when the recovery pin is held at boot, in ms"
	depends on SOC_AMBIQ_DEEPER_SLEEP_RECOVERY
	default 10000
	help
	  How long SOC_AMBIQ_DEEPER_SLEEP_RECOVERY blocks suspend-to-disk when it
	  finds the recovery pin asserted at boot. The window has to outlast a
	  debugger connecting and starting an erase.

config ARMV8_1_M_PMU_EVENTCNT
	int
	default 8

rsource "Kconfig.gpu"

endif
